# Servico de IA (opcional: so e lido pelo profile "ai" do docker-compose).
# Copie para .env na raiz e ajuste. Sem .env valem os padroes abaixo (perfil CPU).

AI_MODEL=qwen3:4b
AI_THINK=true
AI_TIMEOUT_SECONDS=600

# LightRAG (SCRUM-31) - embedding e isolamento no Postgres compartilhado.
# Trocar o modelo/dimensao depois exige reindexar (fica gravado nas tabelas).
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
LIGHTRAG_WORKSPACE=pro4tech

# Ollama - perfil CPU (ThinkPad)
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_KEEP_ALIVE=5m
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_FLASH_ATTENTION=1

# Perfil 16 GB + GPU (use junto com docker-compose.gpu.yml):
# OLLAMA_CONTEXT_LENGTH=8192
# OLLAMA_KEEP_ALIVE=30m
# OLLAMA_KV_CACHE_TYPE=f16
